# ============================================
# 知映 zhiying — 环境配置模板
# 用法: cp .env.example .env，然后填入真实值
# 注意: .env 已在 .gitignore 中，绝不提交真实密钥
# 命名与端口约定参照 gewu 项目（D:\projectMenu\gewu\.env）
# ============================================

# ---------- 数据库（PostgreSQL + pgvector，docker-compose） ----------
ZHIYING_DB_NAME=zhiying
ZHIYING_DB_USER=postgres
# 生产必须改强密码（openssl rand -base64 24）
ZHIYING_DB_PASSWORD=change-me
ZHIYING_DB_HOST=localhost
# 宿主机暴露端口（与 gewu 的 15432 对齐，避免与本机 5432 冲突）
ZHIYING_DB_PORT=15432

# ---------- Redis（V0.2 任务队列，对齐 gewu 16379） ----------
ZHIYING_REDIS_HOST=localhost
ZHIYING_REDIS_PORT=16379

# ---------- 模型 API Key ----------
# 共享 Key（视觉与文本都未配置专用 Key 时使用）
SILICONFLOW_API_KEY=
LONGCAT_API_KEY=

# ---------- Key 分离（DR-20 混搭模式，可选） ----------
# 视觉与文本可各自配置专用 Key（优先于共享 Key），支持不同供应商混搭：
# 例：视觉 LongCat + 文本硅基流动，或两边用不同的 LongCat 账号
# ZHIYING_VLM_SILICONFLOW_API_KEY=     # 视觉专用（siliconflow）
# ZHIYING_VLM_LONGCAT_API_KEY=         # 视觉专用（longcat）
# ZHIYING_TEXT_SILICONFLOW_API_KEY=    # 文本专用（siliconflow）
# ZHIYING_TEXT_LONGCAT_API_KEY=        # 文本专用（longcat）

# ---------- 模型与管道配置 ----------
# VLM 提供方：longcat（DR-14 首选，Key 已激活）| siliconflow（备选）
# LongCat-2.5 为思考型模型，代码内置 enable_thinking=false，无需额外配置
ZHIYING_VLM_PROVIDER=longcat
# 硅基流动视觉模型
ZHIYING_SF_VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
# 文本 LLM 提供方：longcat（默认，与 VLM 同 Key）| siliconflow
ZHIYING_TEXT_PROVIDER=longcat
# 文本模型（仅 siliconflow 时生效；longcat 固定 LongCat-2.5）
ZHIYING_TEXT_MODEL=Qwen/Qwen3.5-9B
# embedding 模型（必须与 schema 的 vector(1024) 匹配；Qwen3-Embedding-8B 是 4096 维不兼容）
ZHIYING_EMBED_MODEL=BAAI/bge-m3
# LongCat 端点（Key 激活后生效）
ZHIYING_LONGCAT_BASE=https://api.longcat.chat/openai/v1
ZHIYING_LONGCAT_MODEL=LongCat-2.5

# ---------- FastAPI 服务层（V0.2） ----------
ZHIYING_API_HOST=127.0.0.1
ZHIYING_API_PORT=8600
# MCP Server 连接的 API 地址（Agent 机器与本机不同时改为 http://<host>:8600）
ZHIYING_API_BASE=http://127.0.0.1:8600

# ---------- 本地 Whisper（第三级转写保底） ----------
# 模型：tiny|base|small|medium（small 约 500MB，中英文兼顾）
ZHIYING_WHISPER_MODEL=small
# VAD 默认关闭：背景音乐重的视频会被 VAD 过滤成 0 段（实测）
ZHIYING_WHISPER_VAD=0
# beam_size，1 比 5 快约 5 倍
ZHIYING_WHISPER_BEAM=1
# HuggingFace 模型源：国内必须用镜像
HF_ENDPOINT=https://hf-mirror.com

# ---------- 数据目录（视频/帧/转写产物，体积大） ----------
# 缺省为仓库内 data/（已 gitignore）；可改到独立磁盘
# ZHIYING_DATA=D:\zhiying-data

# ---------- 网络 ----------
# 代理（访问 YouTube 等外网站点时需要）
# ZHIYING_PROXY=http://127.0.0.1:7890
